# Skopiuj do .env (ignorowany przez git) albo uruchom scripts\setup.ps1, który wygeneruje wartości.
# MariaDB (lokalna, przenośna, tylko 127.0.0.1)
TIBIAAI_DB_PORT=3317
TIBIAAI_DB_NAME=tibiaai_canary
TIBIAAI_DB_USER=canary
TIBIAAI_DB_PASSWORD=
TIBIAAI_DB_ROOT_PASSWORD=

# Konto testowe gracza (tworzone przez scripts\setup.ps1)
TIBIAAI_TEST_ACCOUNT=
TIBIAAI_TEST_EMAIL=
TIBIAAI_TEST_PASSWORD=

# Konto agenta bojowego (scripts\lab-fixture.ps1 -Combatant)
TIBIAAI_AGENT_EMAIL=
TIBIAAI_AGENT_PASSWORD=

# Brain
TIBIAAI_BRAIN_PROVIDER=rules

# Adres swiata. Domyslnie 127.0.0.1. Inny tylko na prywatny pokaz przez VPN: DOCS/PRIVATE_DEMO_VPN.md
TIBIAAI_WORLD_HOST=
